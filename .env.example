# Copy to .env (git-ignored) and fill in. Never commit real values.
MATTERPORT_API_KEY=
# Hidden "API token" in the sponsor toolkit (paired with API key above)
MATTERPORT_API_SECRET=
MATTERPORT_SDK_KEY=
VEXCEL_API_KEY=
LLM_API_KEY=
VISION_API_KEY=
# Model provider for the app's own calls: openai (team default) or anthropic (backup)
TYPECAST_LLM_PROVIDER=openai
# Exact model ids from the provider's model list; the vision model must accept images
TYPECAST_LLM_MODEL=
TYPECAST_VISION_MODEL=
# Director/text reasoning; scouts use a separate model instance at lower effort
TYPECAST_REASONING_EFFORT=medium
TYPECAST_SCOUT_REASONING_EFFORT=low
# Set 0 for offline deterministic runs
TYPECAST_ENABLE_MODEL_PARSE=1
TYPECAST_ENABLE_VISION_RERANK=1
# Vision pool and execution controls selected on the five tuning scenes
TYPECAST_RERANK_POOL=20
TYPECAST_VISION_CONCURRENCY=5
# 1 scores each image separately; 5 or 10 sends a validated group in one request
TYPECAST_VISION_BATCH_SIZE=5
# Optional private score-cache directory for uncached experiments, under cache/
TYPECAST_RERANK_CACHE_DIR=
# Optional second provider for ordinary failures; rate limits stop further calls
TYPECAST_FALLBACK_PROVIDER=
TYPECAST_FALLBACK_MODEL=
FALLBACK_API_KEY=
# 1 = scan images may be sent to the vision model (sponsor permission confirmed Nov 14)
TYPECAST_ALLOW_VISION_UPLOAD=0
# fixed = deterministic pipeline, deep = deepagents engine (falls back to fixed on error)
TYPECAST_ENGINE=fixed
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=typecast
LANGSMITH_TRACING=true
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
TEAM_INBOX=
# 1 = tools return mocks/ data (default until real lanes land)
TYPECAST_USE_MOCKS=1
